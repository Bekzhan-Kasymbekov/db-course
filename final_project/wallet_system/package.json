{
  "name": "wallet-system",
  "version": "1.0.0",
  "description": "Ledger-based Express and PostgreSQL wallet API secured with Keycloak OIDC, JWT validation, RBAC, and account ownership checks.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "keywords": [
    "keycloak",
    "openid-connect",
    "jwt",
    "express",
    "postgresql",
    "rbac",
    "ledger"
  ],
  "author": "Bekzhan Kasymbekov",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.6",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
