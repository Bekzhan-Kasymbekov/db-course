PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_local_postgres_password
DB_NAME=wallet_system

KEYCLOAK_ISSUER=http://localhost:8080/realms/wallet
KEYCLOAK_CLIENT_ID=wallet-api
KEYCLOAK_CLIENT_SECRET=replace_with_secret

